// MODEL DESCRIPTION:
// View Weapon Model: Quantum Destabilzer/Particlizer.
//
// MODEL AUTHOR:
// Michael

// -----------------------------------------------------------------------------
// FILE DECLARATIONS
//
// Model Commands
path models/quantum
origin 70 -3 -30
scale 1.5

// Base Model
quant_base2.sbm

// Skins
normal	    		quant_grid.tga

// Normal Animations
ready      	        ready.sam
putaway  		particle_putaway.sam
idle 			particle_idle.sam
fire                    particle_fire.sam
releasefire             particle_release.sam

//secondaryready        destab_ready.sam
//primaryidle  		particle_idle.sam
//primaryfire   	particle_fire.sam
//releasefire  		particle_release.sam
//primaryputaway	particle_putaway.sam
//secondaryidle		destab_idle.sam
//secondaryfire		fire2.sam
//secondaryputaway	destab_putaway.sam
//primary2secondary	switchto.sam
//secondary2primary 	switchback.sam

// Define group areas
id 200 group weapon bone barrel 0 0 0
//id 800 group core fullbright translucent66

// -----------------------------------------------------------------------------
// INITIALIZATION SECTION
//
!init:

// Class Setup
server actionincrement 80
server setaimanim primaryidle 0

// Client Sound Aliases
client aliascache snd_fire1     "weapons/quantum/fire.wav"
//client aliascache snd_altfire1  "weapons/quantum/altfire.wav"
client aliascache snd_powerup1  "weapons/quantum/powerup.wav"
client aliascache snd_loop1     "weapons/quantum/loop.wav"
client aliascache snd_open1     "weapons/quantum/open.wav"
client aliascache snd_close1    "weapons/quantum/close.wav"
client aliascache snd_flame1    "weapons/quantum/flame3.wav"
client aliascache snd_upsec1    "weapons/quantum/loop2up.wav"
client aliascache snd_downsec1  "weapons/quantum/loop2down.wav"
client aliascache snd_altloop1  "weapons/quantum/loop2.wav"
client aliascache snd_null1     "misc/null.wav"

// -----------------------------------------------------------------------------
// MAIN SECTION
//
!main:

server fire first destruct_time 5 // 5 seconds till this thing self destructs
server fire first eatammo
client fire first randomsound snd_powerup 1 7

client ready first randomsound snd_open .3 7
client ready last randomsound snd_loop .3 7

client putaway first randomsound snd_close .7 7

server releasefire first shoot
client releasefire first randomsound snd_fire 1 7
server releasefire first weaponsound

