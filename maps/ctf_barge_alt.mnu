enditem

menuitem "fc 0.7 0.7 0.7 0.7 oxl 57 oyt -186 string \"Return to previous menu...\""
selitem  "fc 1 1 1 1 oxl 57 oyt -186 cursor string \"Return to previous menu...\""
helpdata "fc 1 1 1 1 jcx yv -160 boxtext \"This option takes you back to\nthe start server selection menu.\""
actionitem "popmenu"
enditem
