menulevel dm_mapinfo1

headeritem "fade 0.66 oxl 40 oyt -198 picn ctf_barge3"
enditem
headeritem "fc 1 1 1 1 jcx oyt -76 boxtext \"CTF_Barge\""
enditem

headeritem "fc 1 1 1 1 oxl 87 oyt -100 string \"Map Title: \""
enditem
headeritem "fc 0.53 0.53 1 0.8 oxl 167 oyt -100 string \"CTF_Barge\""
enditem

headeritem "fc 1 1 1 1 oxl 87 oyt -110 string \"Map Name: \""
enditem
headeritem "fc 0.53 0.53 0.83 1 oxl 167 oyt -110 string \"ctf_barge.bsp\""
enditem

headeritem "fc 1 1 1 1 oxl 87 oyt -120 string \"Map Type: \""
enditem
headeritem "fc 0.53 0.53 0.83 1 oxl 167 oyt -120 string \"CTF\""
enditem

headeritem "fc 1 1 1 1 oxl 87 oyt -140 string \"Created by: \""
enditem
